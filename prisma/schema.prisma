datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Product {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String
  price        Int
  category     String          // TEMPLATE, PRESET, EBOOK
  previewImage String
  digitalFile  String
  features     String          // JSON array stored as string
  isPublished  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tokens       DownloadToken[]
  reviews      Review[]
}

model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  customerName      String
  customerEmail     String
  customerPhone     String
  totalAmount       Int
  discountAmount    Int             @default(0)
  couponCode        String?
  status            String          @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  dokuInvoiceNumber String?
  dokuPaymentUrl    String?
  productId         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tokens            DownloadToken[]
  reviews           Review[]
}

model DownloadToken {
  id            String   @id @default(uuid())
  token         String   @unique
  orderId       String
  productId     String
  expiresAt     DateTime
  downloadCount Int      @default(0)
  maxDownloads  Int      @default(10)
  createdAt     DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  orderId      String
  customerName String
  rating       Int      // 1 to 5
  comment      String
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
